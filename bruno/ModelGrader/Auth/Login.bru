meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/login
  body: json
  auth: none
}

body:json {
  {
    "username": "",
    "password": ""
  }
}

script:post-response {
  if (res.body.access_token) {
    bru.setEnvVar("access_token", res.body.access_token);
  }
  if (res.body.account_id) {
    bru.setEnvVar("account_id", res.body.account_id);
  }
}
